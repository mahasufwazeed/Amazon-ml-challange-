# Virtual Environment
.venv/
env/
venv/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.coverage
htmlcov/

# Model checkpoints & large binary artifacts
models/*
!models/.gitkeep
*.joblib
*.pkl

# Generated inference outputs (large TSV prediction files)
output/*.tsv
!output/.gitkeep

# Temporary SQLite buffers and logs
*.db
*.sqlite
*.sqlite3
*.log

# Raw large datasets (keep structure via .gitkeep)
*.zip
dataset/train/*.tsv
dataset/test/*.tsv
!dataset/train/.gitkeep
!dataset/test/.gitkeep

# IDE / OS metadata
.idea/
.vscode/
*.swp
*.swo
**/.DS_Store
Thumbs.db
